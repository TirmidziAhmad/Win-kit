# Konfigurasi Windows Installer Toolkit
VM_RAM="4G"
VM_CPUS="4"
DEFAULT_ISO_DIR="/home/pc-it/Downloads"

# OVMF Firmware (Standard UEFI - tanpa Secure Boot)
OVMF_CODE="/usr/share/edk2/x64/OVMF_CODE.4m.fd"
# OVMF Firmware (Dengan Secure Boot)
OVMF_CODE_SECBOOT="/usr/share/edk2/x64/OVMF_CODE.secboot.4m.fd"
OVMF_VARS_TEMPLATE="/usr/share/edk2/x64/OVMF_VARS.4m.fd"
OVMF_VARS_TMP="/tmp/win_kit_ovmf_vars.fd"

# swtpm (Software TPM 2.0)
SWTPM_STATE_DIR="/tmp/win_kit_swtpm"
